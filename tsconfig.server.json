{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist/server",
    "rootDir": "./src"
  },
  "include": [
    "src/domain/**/*",
    "src/application/**/*",
    "src/infrastructure/**/*",
    "src/adapters/**/*",
    "src/server/**/*",
    "src/cli/**/*"
  ],
  "exclude": ["src/ui/**/*", "tests/**/*"]
}
